{
  "name": "mirador-desktop",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "electrobun dev",
    "build:dev": "electrobun build --env=dev",
    "build": "ELECTROBUN_DEVELOPER_ID=${ELECTROBUN_DEVELOPER_ID:--} electrobun build --env=stable",
    "build:release": "scripts/stage-mirador.sh && MIRADOR_DESKTOP_RELEASE=1 TAR_OPTIONS=--format=ustar ELECTROBUN_DEVELOPER_ID=${ELECTROBUN_DEVELOPER_ID:--} electrobun build --env=stable",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "electrobun": "2.0.2"
  }
}
