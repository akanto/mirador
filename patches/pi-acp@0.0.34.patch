index 0000000000000000000000000000000000000000..c6473b6c73e4d89683247c7801bd41502dcbfb9d
--- /dev/null
+++ b/dist/mcp-servers-extension.js
@@ -0,0 +1,27 @@
+/**
+ * Loaded into each pi that pi-acp starts for a session with MCP servers: it hands the servers the ACP client sent in
+ * session/new or session/load to pi's built-in MCP support, with their tools declared to the model directly.
+ */
+const MCP_SERVERS_VARIABLE = "PI_ACP_MCP_SERVERS";
+const SERVERS_KEY = Symbol.for("pi-acp.mcpServers");
+
+/**
+ * Read once per process, as a reload loads the extension again, and taken out of the environment, which the bash tool's
+ * commands inherit, since server headers and environments can hold credentials.
+ */
+function sessionServers() {
+  globalThis[SERVERS_KEY] ??= JSON.parse(process.env[MCP_SERVERS_VARIABLE] ?? "[]");
+  delete process.env[MCP_SERVERS_VARIABLE];
+  return globalThis[SERVERS_KEY];
+}
+
+const asObject = (pairs) => Object.fromEntries((pairs ?? []).map(({ name, value }) => [name, value]));
+
+function piServerConfig(server) {
+  if (server.type === "http") return { url: server.url, headers: asObject(server.headers) };
+  return { command: server.command, args: server.args ?? [], env: asObject(server.env) };
+}
+
+export default function (pi) {
+  for (const server of sessionServers()) pi.registerMcpServer(server.name, { ...piServerConfig(server), exposure: "direct" });
+}
